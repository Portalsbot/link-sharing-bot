# Required Telegram and database configuration
BOT_TOKEN=123456:replace_me
OWNER_ID=123456789
ADMINS=
CLONE_ID=official
DATABASE_URL=postgresql://user:password@host:5432/database

# Branding: this direct image URL is used unless BRANDING_IMAGE_PATH is set.
BRANDING_IMAGE_URL=https://i.ibb.co/PGpMYwYY/Gemini-Generated-Image-a7tjlia7tjlia7tj.png
BRANDING_IMAGE_PATH=
SMALL_CAPS=true

# Optional official channel button shown on Start/About/Help.
CHANNEL_URL=

# Optional shared settings used by this project foundation
STORAGE_CHANNEL_ID=
DEFAULT_AUTO_DELETE=0
MAX_FILES_PER_USER=50

# Required only when using /set_api. Exact trusted hostnames, comma-separated.
SHORTENER_ALLOWED_HOSTS=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHORTENER_ENCRYPTION_KEY=
